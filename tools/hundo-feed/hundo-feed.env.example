# Copy to /etc/hundo-feed.env and fill in (chmod 600; it holds provider credentials).
# Existing installations without HUNDO_PROVIDER continue using livepokemap.
HUNDO_PROVIDER=pogocoordinates
# Paste the token value only; do not include the "Bearer " prefix.
POGO_TOKEN=your-pogocoordinates-token
# map writes approximate markers to map_candidates for diagnostics, never sniper targets.
# exact publishes only revealed positions and is heavily limited by account quota.
POGO_COORDINATE_MODE=exact
# Fixed worldwide grid width/height in degrees: 15, 30, 45, or 60.
# 30 uses 72 regions, queried in batches of 18 with a five-second pause.
POGO_TILE_DEGREES=30
# Refine 14 populated continental regions to 15 degrees (114 total regions).
POGO_REFINE_DENSE=1
# Three slots revisit populated areas; every fourth explores the worldwide grid.
POGO_PRIORITIZE_ACTIVE=1
# Exact mode uses eight regions; map mode uses the configured geographic grid.
# Each region is subject to the provider's 100-result/account cap.
# Custom bounds are south,north,west,east; exact mode uses a single lookup.
POGO_BOUNDS=-85,85,-180,180
# New exact-coordinate requests per poll; successful reveals are cached until despawn.
POGO_REVEALS_PER_POLL=1
# VIP can request 500 per region. Keep 100 for the lower account tier.
POGO_LOOKUP_RESULTS=100
# Pause between new exact-coordinate requests; provider cooldowns always take precedence.
POGO_REVEAL_PAUSE_SECONDS=2
# For HUNDO_PROVIDER=livepokemap instead:
# LPM_USERNAME=your-livepokemap-username
# LPM_PASSWORD=your-livepokemap-password
# Inside your web server's site folder, so it is served as https://<your site>/pgrazor/hundos.json
HUNDO_OUT=/var/www/example.com/pgrazor/hundos.json
HUNDO_INTERVAL=300
HUNDO_STATE=/var/lib/hundo-feed/token
