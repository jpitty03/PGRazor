# Copy to /etc/hundo-feed.env and fill in (chmod 600; it holds the LivePokeMap password).
LPM_USERNAME=your-livepokemap-username
LPM_PASSWORD=your-livepokemap-password
# Inside your web server's site folder, so it is served as https://<your site>/pgrazor/hundos.json
HUNDO_OUT=/var/www/example.com/pgrazor/hundos.json
HUNDO_INTERVAL=30
HUNDO_STATE=/var/lib/hundo-feed/token
